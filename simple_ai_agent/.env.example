# ==========================================
# Google Gemini API Key Configuration
# ==========================================
# 1. Obtain an API key from Google AI Studio:
#    https://aistudio.google.com/app/apikey
# 2. Rename or copy this file to `.env`:
#    copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# 3. Replace the placeholder value below with your actual API key:

GEMINI_API_KEY=your_gemini_api_key_here

# Optional default model override (defaults to gemini-2.5-flash if not specified)
# GEMINI_MODEL=gemini-2.5-flash
